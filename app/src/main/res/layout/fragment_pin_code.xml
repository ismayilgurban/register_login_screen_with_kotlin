<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CreatePinFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/textCreatePin"
            android:layout_width="match_parent"
            android:layout_height="37dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Pini daxil et"
            android:textColor="@color/black"
            android:textSize="20dp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/inputPin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView3"></TextView>

        <TextView
            android:id="@+id/inputPin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.5"
            android:text="●●●●"
            android:textColor="@color/black"
            android:textSize="30sp"
            app:layout_constraintBottom_toTopOf="@+id/fragment_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textCreatePin"></TextView>

        <GridLayout
            android:id="@+id/fragment_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="159dp"
            android:alignmentMode="alignMargins"
            android:padding="20dp"
            android:rowCount="4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/inputPin">

            <Button
                android:id="@+id/btnbackspace"
                style="@style/PinButtons"
                android:layout_row="3"
                android:layout_column="2"
                android:layout_gravity="center"
                android:text="⌫"
                android:textSize="18dp"></Button>

            <Button
                android:id="@+id/btn0"
                style="@style/PinButtons"
                android:layout_row="3"
                android:layout_column="1"
                android:text="0"></Button>

            <Button
                android:id="@+id/btn1"
                style="@style/PinButtons"
                android:layout_row="0"
                android:layout_column="0"
                android:text="1"></Button>

            <Button
                android:id="@+id/btnhelp"
                style="@style/PinButtons"
                android:layout_row="3"
                android:layout_column="0"
                android:layout_gravity="center"
                android:text="Kömək"
                android:textSize="13dp"></Button>

            <Button
                android:id="@+id/btn3"
                style="@style/PinButtons"
                android:layout_row="0"
                android:layout_column="2"
                android:text="3"></Button>

            <Button
                android:id="@+id/btn4"
                style="@style/PinButtons"
                android:layout_row="1"
                android:layout_column="0"
                android:text="4"></Button>

            <Button
                android:id="@+id/btn5"
                style="@style/PinButtons"
                android:layout_row="1"
                android:layout_column="1"
                android:text="5"></Button>

            <Button
                android:id="@+id/btn6"
                style="@style/PinButtons"
                android:text="6"></Button>

            <Button
                android:id="@+id/btn7"
                style="@style/PinButtons"
                android:layout_row="2"
                android:layout_column="0"
                android:text="7"></Button>

            <Button
                android:id="@+id/btn8"
                style="@style/PinButtons"
                android:text="8"></Button>

            <Button
                android:id="@+id/btn9"
                style="@style/PinButtons"
                android:layout_row="2"
                android:layout_column="2"
                android:text="9"></Button>

            <Button
                android:id="@+id/btn2"
                style="@style/PinButtons"
                android:layout_row="0"
                android:layout_column="1"
                android:text="2"></Button>
        </GridLayout>

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="103dp"
            android:layout_height="87dp"
            android:layout_marginTop="77dp"
            android:src="@drawable/app_logo"
            app:layout_constraintBottom_toTopOf="@+id/textView3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Xoşgəldin, user"
            android:textSize="20sp"
            android:textColor="#3f4042"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/textCreatePin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView3" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>